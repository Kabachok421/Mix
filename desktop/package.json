{
  "name": "mix-messenger",
  "productName": "Mix",
  "version": "1.0.0",
  "description": "Mix — мессенджер для Windows",
  "author": "m3lts-lab",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "start": "electron .",
    "dev": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.m3lts.mix",
    "productName": "Mix",
    "copyright": "Copyright © m3lts-lab",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "config.default.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mix",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1049",
      "artifactName": "Mix-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kabachok421",
        "repo": "Mix",
        "releaseType": "release"
      }
    ]
  }
}
